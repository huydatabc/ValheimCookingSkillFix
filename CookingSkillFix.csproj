<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CookingSkillFix</AssemblyName>
    <RootNamespace>CookingSkillFix</RootNamespace>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- From NuGet -->
    <PackageReference Include="HarmonyX"  Version="2.*" />
    <PackageReference Include="JotunnLib" Version="2.*" />

    <!-- From refs/ (uploaded as individual files to the 'refs' GitHub release) -->
    <Reference Include="BepInEx">
      <HintPath>refs/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>refs/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>refs/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
