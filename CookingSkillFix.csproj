<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CookingSkillFix</AssemblyName>
    <RootNamespace>CookingSkillFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>

    <!-- Jotunn from NuGet is fine -->
    <PackageReference Include="JotunnLib" Version="2.*" />

    <!-- BepInEx -->
    <Reference Include="BepInEx">
      <HintPath>refs/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Valheim game assembly -->
    <Reference Include="Assembly-CSharp">
      <HintPath>refs/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony from BepInEx pack -->
    <Reference Include="0Harmony">
      <HintPath>refs/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>refs/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>refs/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>

</Project>
